# PCAGO server image (Shiny Server) — powers https://pcago.bioinf.uni-jena.de
#
# Build (from the repository root; amd64 only, rocker/shiny has no arm64 image):
#   docker build --platform linux/amd64 \
#     --build-arg PCAGO_VERSION=$(git describe --always --dirty) \
#     -t trichterhub/pcago-server:2.0 -t trichterhub/pcago-server:latest -f Dockerfile_server .
# Run:
#   docker run -p 8000:8000 -v "$(pwd)"/logs:/home/shiny/logs trichterhub/pcago-server:2.0
#
# Base: R 4.6.2 + Shiny Server (bundles a supported Node.js LTS) on Ubuntu 26.04 LTS.
# Pinned by digest for reproducible builds; bump tag + digest together.
FROM rocker/shiny:4.6.2@sha256:ca9c2772c5fe7907e8cf27f5778a34673851d6e22e34ad136e9f517f873061b7

ARG DEBIAN_FRONTEND=noninteractive

# Keep the historical uid 999 of the "shiny" user so existing host log directories
# keep working (rocker now creates it with uid 996; gid 999 is taken by systemd-journal,
# so only the uid is changed).
ARG SHINY_UID=999
RUN usermod -u ${SHINY_UID} shiny

# System libraries needed by the R packages (see renv::sysreqs) and ffmpeg for PCA movies
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      ffmpeg \
      cmake make pandoc \
      libbz2-dev libcairo2-dev libcurl4-openssl-dev libfontconfig1-dev libfreetype6-dev \
      libfribidi-dev libharfbuzz-dev libicu-dev liblzma-dev libpng-dev libssl-dev \
      libuv1-dev libxml2-dev zlib1g-dev \
      libtcl8.6 libtk8.6 \
    && rm -rf /var/lib/apt/lists/*

# R packages: exact versions from renv.lock (CRAN binaries from a dated Posit Package
# Manager snapshot, Bioconductor packages from bioconductor.org)
# Use R's built-in untar (TAR=internal, renv.tar.exe = ""): GNU tar on Ubuntu 26.04 fails
# under amd64 emulation on Apple Silicon ("Cannot mkdir: Function not implemented").
# Harmless on native amd64 hosts. libtcl/libtk above: misc3d (plot3D) loads tcltk.
COPY src/renv.lock /tmp/renv.lock
RUN export TAR=internal R_INSTALL_TAR=internal \
    && R -q -e "install.packages(c('renv', 'BiocManager'), repos = 'https://p3m.dev/cran/__linux__/resolute/2026-11-22')" \
    && R -q -e "options(renv.tar.exe = '', Ncpus = parallel::detectCores()); renv::restore(lockfile = '/tmp/renv.lock', library = .libPaths()[1], prompt = FALSE)" \
    && rm -rf /tmp/renv.lock /tmp/Rtmp* /root/.cache/R

# Application code: copied from the build context, i.e. pinned to the checked-out commit
COPY --chown=shiny:shiny src/ /srv/pcago/
COPY docker/shiny-server.conf /etc/shiny-server/shiny-server.conf

ARG PCAGO_VERSION=unknown
ENV PCAGO_VERSION=${PCAGO_VERSION} \
    SHINY_LOG_STDERR=1

# Shiny Server does not forward container env vars to apps; R reads Renviron.site
RUN echo "PCAGO_VERSION=${PCAGO_VERSION}" >> "${R_HOME}/etc/Renviron.site"

RUN mkdir -p /home/shiny/logs /var/lib/shiny-server /var/log/shiny-server \
    && chown -R shiny:shiny /home/shiny /var/lib/shiny-server /var/log/shiny-server

EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -fsS http://localhost:8000/ > /dev/null || exit 1

USER shiny
CMD ["shiny-server"]
